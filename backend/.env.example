# Spotify Developer credentials - get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# OAuth callback - must match a redirect URI registered on the Spotify dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Frontend origin, used for CORS
FRONTEND_URL=http://127.0.0.1:5173

# Any long random string - used to sign session cookies
SESSION_SECRET=change_me_to_a_random_string_at_least_32_chars_long